{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@tracker/domain": ["./libs/domain/src/index.ts"],
      "@tracker/db-types": ["./libs/db-types/src/index.ts"],
      "@web/*": ["./apps/web/src/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
